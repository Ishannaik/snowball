# Snowball settings. Secrets use environment variables or SNOWBALL_ENV_FILE.
# Discord channel for the digest. Empty = write digests/YYYY-MM-DD.md only, never post.
DIGEST_CHANNEL_ID=

# --- Multi-model orchestrator (tools/orchestrator.py). Secrets stay in .env, never here. ---
# auto = Gemini extracts, Grok verifies, Local only for private topics or when an engine is down.
# A private topic (private: true) never reaches Gemini or Grok, whatever the mode says.
ORCH_DEFAULT_MODE=auto
ORCH_MAX_TOPICS=2
ORCH_PAGES_PER_TOPIC=12
ORCH_QUERIES_PER_TOPIC=6
KB_ANSWER_MIN_CLAIMS=5
INDIA_ELIGIBILITY_CHECK=1

# GeminiBulkExtractor: wide-context extraction (needs GEMINI_API_KEY in .env)
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash
# docs on 2026-10-07 use gemini-3.8-flash everywhere; the 2.5 ids in the original brief are older. Swap back here if needed.
GEMINI_PRO_MODEL=gemini-3.1-pro
GEMINI_MAX_INPUT_CHARS=3000000
GEMINI_EXTRACT_BUDGET_IN=800000
GEMINI_EXTRACT_BUDGET_OUT=16000
GEMINI_TOKENS_PER_DAY=20000000

# GrokAdversarialVerifier: reject-only review via omp (--no-tools), X search via the grok CLI
OMP_BIN=/usr/local/bin/omp
GROK_VERIFIER_MODEL=cursor/grok-4.7-xhigh
GROK_REASONING_EFFORT=xhigh
GROK_VERIFY_TIMEOUT_SEC=900
VERIFY_TOKEN_BUDGET_IN=60000
VERIFY_TOKEN_BUDGET_OUT=8000
GROK_EXTRACT_BUDGET_IN=120000
GROK_EXTRACT_BUDGET_OUT=16000
GROK_TOKENS_PER_DAY=8000000
GROK_X_BIN=/home/ubuntu/.local/bin/grok
GROK_X_MODEL=
GROK_X_POLL_SEC=180
GROK_X_WINDOW_DAYS=30

# Local models use the authenticated SSH tunnel to Oracle's internal endpoint.
# Goku 8800 forwards to Oracle loopback 8799; no API credential is copied.
OPENAI_BASE_URL=http://127.0.0.1:8800/v1
LOCAL_MODEL=ornith-1.5-35b-a3b-abliterated
LOCAL_FALLBACK_MODEL=qwen3.8-27b-abliterated
EXTRACT_TOKEN_BUDGET_IN=12000
EXTRACT_TOKEN_BUDGET_OUT=4000
LOCAL_TOKENS_PER_DAY=2000000

# All engines together, in + out, per IST day
LLM_TOKENS_PER_DAY=32000000
COLLECTOR_CONCURRENCY=6
DOMAIN_RATE_PER_MIN=6
MAX_BODY_BYTES=5242880

# Paid routes stay off until an operator sets ACCESS_PAID_PROVIDER and nonzero ceilings.
# A key in .env is not activation. ZenRows mode=auto is a 25-credit weight, not a dollar tariff.
ACCESS_PAID_PROVIDER=
ZENROWS_MODE=auto
PAID_FETCH_MIN_YIELD_SCORE=0.30
MAX_PROXY_BYTES_PER_ACQUISITION=20971520
MAX_PAID_RETRIEVALS_PER_ACQUISITION=2

# The challenge fixture stays off. Setting this to 1 is not provider activation.
# CAPTCHA_API_KEY is an environment secret and must not be written in this file.
SNOWBALL_CHALLENGE_FIXTURE=0

# Provider implementation does not activate spending. Set explicit approved limits
# only after credentials, funded balance, current tariffs, and access.yml exist.
ACCESS_MODE=auto
MAX_PAID_FETCHES_PER_DAY=0
MAX_CAPTCHA_SOLVES_PER_DAY=0
PAID_DAILY_BUDGET_MICRO_USD=0
PAID_MONTHLY_BUDGET_MICRO_USD=0
MAX_SOLVES_PER_ACQUISITION=1
ACCESS_DEADLINE_SEC=240
CAPTCHA_DEADLINE_SEC=120
CAPTCHA_POLL_SEC=5
BROWSER_CONCURRENCY=1
BROWSER_WORKER_MEMORY_MB=768
SESSION_TTL_SEC=600

# Delivery can use an existing Oracle bridge token without copying it here.
# Set DISCORD_BRIDGE_HOST and DISCORD_TOKEN_FILE in the host environment.
# The empty channel above deliberately keeps posting inactive by default.
