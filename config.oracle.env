# Public research only. OMP's agy-pool provider points to Oracle's existing
# OpenAI-compatible AGY proxy at http://127.0.0.1:8088/v1.
# OAuth credentials remain in the existing proxy account store, outside Git.
ORCH_DEFAULT_MODE=gemini-bulk
GEMINI_TRANSPORT=omp
GEMINI_MODEL=agy-pool/gemini-3.8-flash
GEMINI_PRO_MODEL=agy-pool/gemini-3.1-pro
OMP_BIN=/usr/local/bin/omp
# Legacy adapter/accounting name; the actual verifier is Claude via AGY.
GROK_VERIFIER_MODEL=agy-pool/claude-sonnet-4-6
GROK_REASONING_EFFORT=medium
GROK_VERIFY_TIMEOUT_SEC=180
GROK_X_POLL_SEC=45
EXA_ROTATOR_URL=http://127.0.0.1:8791
LLM_TOKENS_PER_DAY=800000
GEMINI_TOKENS_PER_DAY=600000
GROK_TOKENS_PER_DAY=200000
ORCH_PAGES_PER_TOPIC=4
ORCH_QUERIES_PER_TOPIC=2
COLLECTOR_CONCURRENCY=2
