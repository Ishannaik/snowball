# Generic runtime: direct explicit-payload roles. Installing config never grants execution.
SNOWBALL_MODEL_BASE_URL=http://127.0.0.1:8088/v1
SNOWBALL_INTERVIEW_MODEL=gemini-3.8-flash-high
SNOWBALL_PLANNER_MODEL=gemini-3.8-flash-high
SNOWBALL_RESEARCH_MODEL=gemini-3.8-flash-high
SNOWBALL_SYNTHESIS_MODEL=gemini-3.8-flash-high
SNOWBALL_REVIEW_MODEL=claude-sonnet-4-6
SNOWBALL_JUDGE_MODEL=claude-sonnet-4-6
SNOWBALL_MAX_OUTPUT_TOKENS=4096
SNOWBALL_SEARCH_URL=http://127.0.0.1:8791/search

# Preserved legacy crawler configuration below; not a generic goal or a grant.
# Public research only. OMP's agy-pool provider points to Oracle's existing
# OpenAI-compatible AGY proxy at http://127.0.0.1:8088/v1.
# OAuth credentials remain in the existing proxy account store, outside Git.
ORCH_DEFAULT_MODE=gemini-bulk
GEMINI_TRANSPORT=omp
GEMINI_MODEL=agy-pool/gemini-3.8-flash
GEMINI_PRO_MODEL=agy-pool/gemini-3.1-pro
OMP_BIN=/usr/local/bin/omp
REVIEW_MODEL=agy-pool/claude-sonnet-4-6
REVIEW_TRANSPORT=omp
REVIEW_TIMEOUT_SEC=180
REVIEW_TOKENS_PER_DAY=200000
REVIEW_BUDGET_IN=60000
REVIEW_BUDGET_OUT=8000
PLAN_MODEL=agy-pool/claude-sonnet-4-6
PLAN_TRANSPORT=omp
PLAN_TOKENS_PER_WAVE=8000
PLAN_MAX_HYPOTHESES_PER_WAVE=6
PLAN_EXPLORATION_SHARE=0.3
PRIVATE_MODEL_ENDPOINT=
PRIVATE_MODEL_ID=
PRIVATE_MODEL_ATTESTED=0
PRIVATE_MODEL_ISOLATION=
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8989
CONSOLE_ALLOWED_ORIGINS=
CONSOLE_COOKIE_SECURE=1
GROK_REASONING_EFFORT=medium
GROK_X_POLL_SEC=45
EXA_ROTATOR_URL=http://127.0.0.1:8791
LLM_TOKENS_PER_DAY=800000
GEMINI_TOKENS_PER_DAY=600000
ORCH_PAGES_PER_TOPIC=4
ORCH_QUERIES_PER_TOPIC=2
COLLECTOR_CONCURRENCY=2
