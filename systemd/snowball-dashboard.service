[Unit]
Description=Snowball console
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/snowball
# Generic console only. Model calls still require explicit interview consent or research grants.
# Installing this unit does not approve a goal or start snowball-loop.service.
EnvironmentFile=-/home/ubuntu/repos/snowball/config.oracle.env
ExecStart=/home/ubuntu/repos/snowball/.venv/bin/python /home/ubuntu/repos/snowball/snowball.py goal --db /home/ubuntu/repos/snowball/data/snowball.db serve --origin https://snowball.ishannaik.com --port 8989
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Console writes SQLite under data/. WAL still needs this directory writable.
ReadWritePaths=/home/ubuntu/repos/snowball/data /home/ubuntu/repos/snowball/state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
