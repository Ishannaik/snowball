[Unit]
Description=Snowball read-only evidence dashboard
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/snowball
ExecStart=/home/ubuntu/repos/snowball/.venv/bin/python /home/ubuntu/repos/snowball/snowball.py serve --host 127.0.0.1 --port 8989 --db /home/ubuntu/repos/snowball/data/highered.db
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# SQLite read-only connections still need the WAL shared-memory sidecar.
ReadWritePaths=/home/ubuntu/repos/snowball/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
